# This URL is public browser configuration, not a database credential. Copy this
# file to .env.local and use the Auth Base URL for the existing Neon branch.
VITE_NEON_AUTH_URL="<NEON_MANAGED_AUTH_BASE_URL>"

# Optional public URL for the validation landing page's early-access CTA.
# Leave empty to show the honest "Segera hadir" state. Never put secrets here.
VITE_EARLY_ACCESS_URL=""
