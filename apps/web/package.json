{
  "name": "@family-finance/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:validation": "tsc -b && FAMILY_FINANCE_RELEASE=validation vite build",
    "dev": "vite",
